# FlowProof — copie para .env e ajuste. Nunca versione o .env real.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Caminho do arquivo SQLite (será criado automaticamente)
FLOWPROOF_DB_PATH=./data/flowproof.db
# Permite criar novas contas pela interface (true/false)
FLOWPROOF_ALLOW_REGISTRATION=true
# Cookies com flag Secure (padrão: true quando NODE_ENV=production)
FLOWPROOF_COOKIE_SECURE=
# Confiar em X-Forwarded-For atrás de proxy reverso (true/false)
FLOWPROOF_TRUST_PROXY=false
# Tamanho máximo de upload/JSON em bytes
FLOWPROOF_MAX_BODY_BYTES=2097152
# Execução real (ainda NÃO implementada; apenas informativo)
FLOWPROOF_N8N_BIN=
